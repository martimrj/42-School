NAME		= 	libftprintf.a
CC 			= 	cc
FLAGS		= 	-Wextra -Wall -Werror -I $(LIBFT_DIR)
AR			= 	ar rcs
RM			= 	rm -f
LIBFT_DIR 	=	Libft/
LIBFT 		=	$(LIBFT_DIR)libft.a

SRCS		= 	ft_printf.c ft_printf_c.c \
				ft_printf_str.c src/ft_printf_base.c \
				ft_printf_dec_int.c ft_print_u.c

OBJS		=	$(SRCS:.c=.o)

all: $(NAME)

%.o: %.c ft_print.h
	$(CC) $(FLAGS) -c $< -o $@

$(NAME): $(OBJS)
	make -C $(LIBFT_DIR)
	cp	$(LIBFT) $(NAME)
	$(AR) $(NAME) $(OBJS)

clean:
	$(RM) $(OBJS)
	make -C $(LIBFT_DIR) clean

fclean: clean
	$(RM) $(NAME)
	make -C $(LIBFT_DIR) fclean

re: fclean all

.PHONY: all fclean re
